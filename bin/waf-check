#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * WAF CLI bridge for non-PHP applications.
 *
 * See src/Cli/WafCommand.php for the payload format and exit codes.
 */

ini_set('display_errors', 'stderr');
ini_set('log_errors', '0');
error_reporting(E_ALL);

require dirname(__DIR__) . '/autoload.php';

$command = new FormSpamChecker\Cli\WafCommand();

exit($command->run($argv));
