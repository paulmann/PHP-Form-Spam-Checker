{
    "name": "paulmann/php-form-spam-checker",
    "description": "Framework-agnostic PHP 8.5 spam checker for any PHP form: layered local heuristics (honeypot, signed time trap, rate limit, bot user-agent, keywords, links, SQLi/XSS, disposable e-mail), a CLI/HTTP bridge for non-PHP back ends and evidence for every verdict. Zero runtime dependencies.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "spam",
        "anti-spam",
        "form",
        "form-validation",
        "spam-filter",
        "php",
        "honeypot",
        "rate-limit"
    ],
    "authors": [
        {
            "name": "Paulmann",
            "homepage": "https://github.com/paulmann"
        }
    ],
    "require": {
        "php": ">=8.5",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3"
    },
    "autoload": {
        "psr-4": {
            "FormSpamChecker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FormSpamChecker\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/spam-check"
    ],
    "scripts": {
        "test": "phpunit",
        "test:strict": "phpunit --fail-on-warning --fail-on-risky",
        "lint": "find src tests bin -type f -name '*.php' -exec php -l {} +"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
